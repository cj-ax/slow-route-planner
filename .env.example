# ---------------------------------------------------------------------------
# Slow Route Planner — environment variables
# Copy this file to `.env` and fill in what you have. The app runs fine with
# NOTHING filled in: it falls back to mock data and a keyless map.
# ---------------------------------------------------------------------------

# ----- Server (never exposed to the browser) -----
PORT=3001

# LLM used to turn a natural-language prompt into a route plan.
# Leave blank to use mock route plans. Provider-agnostic placeholder.
LLM_API_KEY=
LLM_MODEL=

# Google Places API key for endpoint search (coffee/beer/food/etc).
# Leave blank to use mock places.
GOOGLE_PLACES_API_KEY=

# Force mock mode even if keys are present. Set to "false" to use real APIs.
USE_MOCKS=true

# BLOB_READ_WRITE_TOKEN is provided automatically by Vercel when you create a
# Blob store and link it to the project. You do NOT need it for local dev —
# locally routes are stored in server/data/routes.json. Only set this if you
# want to test Vercel Blob storage from your machine.
# BLOB_READ_WRITE_TOKEN=

# ----- Client (VITE_* vars ARE bundled into the browser; keep secrets out) -----

# Where the client finds the API. Leave BLANK in both local dev and on Vercel:
# local dev proxies "/api" to the Express server (see client/vite.config.ts),
# and Vercel serves "/api" same-origin. Only set this if you run the client
# against an API on a different origin.
VITE_API_BASE_URL=

# MapLibre style URL. Recommended: a MapTiler dark vector style for the best
# cockpit look, e.g.
#   https://api.maptiler.com/maps/streets-v2-dark/style.json?key=YOUR_KEY
# Leave blank to use the built-in keyless OpenStreetMap raster fallback.
# (This key is visible in the browser — restrict it by domain in MapTiler.)
VITE_MAP_STYLE_URL=
