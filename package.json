{
  "name": "deer-scout",
  "private": true,
  "version": "0.1.0",
  "description": "Personal deer hunting scouting map for public land near Victoria, MN.",
  "type": "module",
  "workspaces": ["client"],
  "scripts": {
    "dev": "npm run dev -w @deer/client",
    "build": "npm run build -w @deer/client",
    "preview": "npm run preview -w @deer/client",
    "typecheck": "tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test -w @deer/client"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
